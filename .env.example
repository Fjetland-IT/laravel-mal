# Mal for .env. Verdiene under er produksjonsoppsettet på vps1 (/srv/<app>/.env, chmod 600,
# eid av app-brukeren). Prod-.env finnes bare på VPS-en og lages av dash/veiviseren.
#
# Lokalt på Macen lager ~/Dev/_oppsett/hent-app.sh .env fra denne fila og overstyrer:
#   APP_ENV=local  APP_DEBUG=true  APP_URL=http://<app>.test
#   DB_CONNECTION=sqlite  SESSION_DRIVER=file  CACHE_STORE=file  QUEUE_CONNECTION=sync
#   MAIL_MAILER=log  og ingen nøkler (SMTP2GO, IndexNow, kjent enhet) satt.

APP_NAME=Appnavn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.no
APP_TIMEZONE=Europe/Oslo

APP_LOCALE=nb
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nb_NO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 på vps1 (bare 127.0.0.1). Database og bruker heter som appen.
# Apper uten MySQL (f.eks. dash) bruker DB_CONNECTION=sqlite og database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

# Valkey på unix-socket (ingen TCP). ACL-bruker per app med nøkkelmønster <app>:*,
# derfor REDIS_PREFIX=<app>:. Krever PHP-utvidelsen redis (php8.5-redis) og at
# app-brukeren er i gruppen valkey.
REDIS_CLIENT=phpredis
REDIS_HOST=/run/valkey/valkey.sock
REDIS_PORT=0
REDIS_USERNAME=app
REDIS_PASSWORD=
REDIS_PREFIX=app:
REDIS_DB=0
REDIS_CACHE_DB=1

# Sesjoner og kø i DB 0, cache i DB 1. Cache og sesjoner har TTL; Valkey kjører
# volatile-lru, så nøkler uten TTL (kø, Cache::forever) kastes ikke ut.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-post fra appen går via SMTP2GO-API-et (app/Mail/Transport/Smtp2goTransport.php).
# Avsenderdomenet må være verifisert (SPF/DKIM) i SMTP2GO.
MAIL_MAILER=smtp2go
MAIL_FROM_ADDRESS="post@example.no"
MAIL_FROM_NAME="${APP_NAME}"
SMTP2GO_API_KEY=

# Innloggingsvarsel for /admin. Tom adresse slår av varselet.
ADMIN_ALERT_EMAIL=
# Enheter med kjent-enhet-cookien varsles ikke. Lag med `openssl rand -hex 32`,
# og åpne /admin/kjent-enhet innlogget på egne enheter.
ADMIN_KNOWN_DEVICE_TOKEN=

# Tofaktor (TOTP) på /admin: påkrevd når APP_ENV=production, ellers av.
# Sett eksplisitt for å overstyre.
# ADMIN_MFA_REQUIRED=true

# IndexNow (Bing/DuckDuckGo m.fl.). Bare i produksjon: `openssl rand -hex 16`.
# Nøkkelen er offentlig (/indexnow.txt).
INDEXNOW_KEY=
# Offentlig vert hvis den ikke er APP_URL.
INDEXNOW_URL=

VITE_APP_NAME="${APP_NAME}"
